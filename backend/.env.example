# ClauseAI backend — copie para backend/.env e preencha. Nunca faça commit do .env.

# ---------- Aplicação ----------
APP_ENV=development
APP_NAME=ClauseAI API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Persistência ----------
# Dados: firebase = Firestore (padrão, funciona no plano gratuito Spark). memory = só em memória, para testes.
PERSISTENCE_BACKEND=firebase
# Arquivos originais (PDF, DOCX ou imagem): local = pasta nesta máquina (padrão, gratuito).
# firebase = Firebase Storage (exige plano Blaze e FIREBASE_STORAGE_BUCKET).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/uploads

# Firebase: preencha OU o caminho do JSON da conta de serviço, OU os três campos abaixo.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave com as quebras de linha escritas como \n, entre aspas duplas.
FIREBASE_PRIVATE_KEY=
# Só com STORAGE_BACKEND=firebase. Ex.: seu-projeto.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ---------- IA: Gemini 3.5 Flash Lite (extração, OCR, avaliação e resumo) ----------
# Provedor de IA: gemini (padrão, exige GEMINI_API_KEY) ou local (determinístico, só para
# desenvolvimento sem serviços externos; use com PERSISTENCE_BACKEND=memory. Recusado em produção).
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Confirme o identificador exato do modelo no Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Conceitos avaliados por chamada na comparação.
ASSESSMENT_BATCH_SIZE=10

# ---------- Limites operacionais ----------
AI_TIMEOUT_SECONDS=120
AI_MAX_ATTEMPTS=3
# Páginas de texto nativo por chamada de extração; documentos maiores são lidos em faixas.
EXTRACTION_PAGES_PER_CALL=30
MAX_UPLOAD_MB=20
MAX_FILES_PER_POLICY=10
WORKER_CONCURRENCY=2

# ---------- Parâmetros de decisão (pendentes de validação de negócio) ----------
PROFILE_MULTIPLIER=1.5
CLOSE_SCORE_THRESHOLD=0.03
MIN_COMPLETENESS=0.70
MIN_EVIDENCE_CONFIDENCE=0.70
