VITE_API_BASE_URL=http://localhost:8000
# Tempo máximo do envio de arquivos, em milissegundos (padrão: 5 minutos).
VITE_UPLOAD_TIMEOUT_MS=300000
# Deve espelhar MAX_UPLOAD_MB do backend (padrão: 20).
VITE_MAX_UPLOAD_MB=20

# Firebase Authentication (anônimo, projeto claude-ai-a36cf). Valores públicos do app web,
# em Configurações do projeto > Seus apps no console do Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=claude-ai-a36cf.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=claude-ai-a36cf
VITE_FIREBASE_APP_ID=

# Só em `npm run dev`: "dev" dispensa o Firebase e envia `Bearer dev-<id>`, aceito pelo
# backend com AUTH_BACKEND=fake. Ignorado no build de produção.
VITE_AUTH_MODE=
